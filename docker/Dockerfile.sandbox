FROM node:20-slim

RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @opencode-ai/sdk

RUN mkdir -p /workspace/project /root/.config/opencode

EXPOSE 4096

WORKDIR /workspace/project

ENV OPENCODE_SERVER_HOSTNAME=0.0.0.0

CMD ["sh", "-c", "opencode serve --port 4096 --hostname 0.0.0.0"]
