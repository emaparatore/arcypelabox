{
  "name": "sandobox-manager",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && tsc -p tsconfig.node.json --watch",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"npm run dev:electron\" \"wait-on http://localhost:5173 dist-electron/main.js && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:critical-flows": "vitest run tests/unit/electron/database.test.ts tests/unit/electron/preload.test.ts tests/unit/electron/proxy.test.ts tests/integration/electron/docker-contract.test.ts tests/integration/renderer/SandboxCreate.test.tsx tests/integration/renderer/OpenCodePanel.test.tsx",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "dockerode": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.arcypelabox",
    "productName": "Arcypelabox",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "imgs/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "imgs/arcypelabox-logo-blu.ico"
    },
    "linux": {
      "icon": "imgs/arcypelabox-logo-round.png"
    }
  }
}
